<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The installer checks for the Windows .NET Framework 4.8 runtime. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <LangVersion>10</LangVersion>
    <AssemblyName>RiotAccountSwitcher</AssemblyName>
    <RootNamespace>RiotAccountSwitcher</RootNamespace>
    <Product>Riot Account Switcher</Product>
    <Version>1.0.1</Version>
    <Authors>R-luiz</Authors>
    <Description>Local Riot account switching with Windows Hello-protected saved sessions.</Description>
    <Copyright>Copyright (c) 2026 R-luiz</Copyright>
    <RepositoryUrl>https://github.com/R-luiz/riot-account-switcher</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinRT projections for Windows Hello (Windows.Security.Credentials). -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.2" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <!-- JavaScriptSerializer; System.Web is only named because System.Web.Extensions depends on it. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
