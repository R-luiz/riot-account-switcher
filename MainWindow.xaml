<Window x:Class="RiotAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riot Account Switcher"
        Icon="app.ico"
        Width="400"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                    Content="+ Add account" Click="OnAddClick" />
            <TextBlock Text="Accounts" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                BorderThickness="1">
            <TextBlock x:Name="BannerText" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" MaxHeight="430" VerticalScrollBarVisibility="Auto">
            <Grid>
                <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="2,8,2,16"
                           Text="No accounts yet. Choose “Add account”, then sign in once in the Riot Client with “Stay signed in” ticked. After that, switching is one click and your Windows Hello PIN." />

                <ItemsControl x:Name="AccountList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Button Style="{StaticResource CardButton}" Tag="{Binding Id}" Click="OnAccountClick"
                                        ToolTip="{Binding Hint}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="36" Height="36">
                                            <Ellipse Fill="{Binding AvatarBrush}" />
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" /><Run
                                                     Text="{Binding Tag, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="9" Padding="8,2" VerticalAlignment="Center"
                                                BorderThickness="1" BorderBrush="{Binding ChipBrush}"
                                                Visibility="{Binding HasChip, Converter={StaticResource Visible}}">
                                            <TextBlock Text="{Binding Chip}" Foreground="{Binding ChipBrush}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Sibling of the card, not a child: a button inside a button would fire both. -->
                                <Button Style="{StaticResource MenuButton}" Tag="{Binding Id}" Click="OnMenuClick"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Content="⋯" ToolTip="Rename or remove" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,4,0,0">
            <ProgressBar x:Name="Progress" Height="2" IsIndeterminate="True" Visibility="Hidden"
                         BorderThickness="0" Background="Transparent" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="Status" Margin="2,8,2,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" />
            <TextBlock Margin="2,8,2,0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11">
                Created by <Hyperlink NavigateUri="https://github.com/R-luiz" RequestNavigate="OnCreditNavigate"
                                      Foreground="{StaticResource Fg}">R-luiz</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
